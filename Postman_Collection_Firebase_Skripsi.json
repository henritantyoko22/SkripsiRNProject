            "description": "Menambahkan mahasiswa baru ke database Firestore atau memperbarui seluruh datanya."
          }
        },
        {
          "name": "4.4 Perbarui Judul Skripsi Saja (Partial Update / Edit Judul)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fields\": {\n    \"judulSkripsi\": { \"stringValue\": \"Optimasi Hyperparameter Model YOLOv8 untuk Deteksi Rambu Lalu Lintas pada Smart Car\" },\n    \"updatedAt\": { \"stringValue\": \"2026-11-09T06:30:00.000Z\" }\n  }\n}"
            },
            "url": {
              "raw": "https://firestore.googleapis.com/v1/projects/{{projectId}}/databases/(default)/documents/mahasiswa/dimas_prasetyo_students_undip_ac_id?updateMask.fieldPaths=judulSkripsi&updateMask.fieldPaths=updatedAt&key={{apiKey}}",
              "protocol": "https",
              "host": ["firestore", "googleapis", "com"],
              "path": ["v1", "projects", "{{projectId}}", "databases", "(default)", "documents", "mahasiswa", "dimas_prasetyo_students_undip_ac_id"],
              "query": [
                {
                  "key": "updateMask.fieldPaths",
                  "value": "judulSkripsi"
                },
                {
                  "key": "updateMask.fieldPaths",
                  "value": "updatedAt"
                },
                {
                  "key": "key",
                  "value": "{{apiKey}}"
                }
