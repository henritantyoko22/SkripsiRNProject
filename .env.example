# Template Environment Variables untuk Portal Skripsi Undip
# Salin file ini menjadi .env dan masukkan kredensial Firebase Anda:
# cp .env.example .env

EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_firebase_project_id
EXPO_PUBLIC_FIREBASE_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
EXPO_PUBLIC_FIREBASE_REVERSED_CLIENT_ID=com.googleusercontent.apps.your_oauth_client_id
EXPO_PUBLIC_FIREBASE_GCM_SENDER_ID=your_gcm_sender_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
EXPO_PUBLIC_FIREBASE_APP_ID=your_firebase_ios_app_id
EXPO_PUBLIC_FIREBASE_BUNDLE_ID=com.undip.SkripsiProjectApp
